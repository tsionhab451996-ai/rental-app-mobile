# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The public URL where this server is reachable (for webhook)
# For local dev: use ngrok https://your-ngrok-url.ngrok.io
# For production: your deployed domain
BASE_URL=https://your-server-url.com

# Port the server listens on
PORT=3000
